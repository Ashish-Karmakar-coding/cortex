{
  "name": "cortex-cli",
  "version": "0.2.0",
  "description": "Cortex — an open-source, local-first agentic coding CLI with bring-your-own-key cloud support.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "cortex": "./dist/cortex.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node dist/cortex.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/verify.ts",
    "start": "node dist/cortex.js",
    "package": "node scripts/package-release.mjs",
    "prepublishOnly": "npm run typecheck && npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "cli",
    "agentic",
    "ollama",
    "local-llm",
    "openai",
    "anthropic",
    "gemini",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ashish-Karmakar-coding/cortex.git"
  },
  "homepage": "https://github.com/Ashish-Karmakar-coding/cortex#readme",
  "bugs": {
    "url": "https://github.com/Ashish-Karmakar-coding/cortex/issues"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.0",
    "@ai-sdk/google": "^1.2.0",
    "@ai-sdk/openai": "^1.3.0",
    "@ai-sdk/openai-compatible": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ai": "^4.3.0",
    "chalk": "^5.4.0",
    "cli-highlight": "^2.1.11",
    "commander": "^13.1.0",
    "diff": "^7.0.0",
    "fast-glob": "^3.3.3",
    "ink": "^5.2.0",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "ollama-ai-provider": "^1.2.0",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "strip-ansi": "^7.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
