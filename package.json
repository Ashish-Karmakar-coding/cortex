{
  "name": "codycli",
  "version": "0.1.0",
  "description": "An open-source, production-grade agentic coding CLI — local-first, multi-provider, with full ReAct loop capabilities.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "cody": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx test/verify.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "cli",
    "agentic",
    "ollama",
    "openai",
    "anthropic",
    "gemini",
    "mcp"
  ],
  "license": "MIT",
  "dependencies": {
    "ai": "^4.3.0",
    "ollama-ai-provider": "^1.2.0",
    "@ai-sdk/openai": "^1.3.0",
    "@ai-sdk/anthropic": "^1.2.0",
    "@ai-sdk/google": "^1.2.0",
    "@ai-sdk/openai-compatible": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^13.1.0",
    "ink": "^5.2.0",
    "ink-text-input": "^6.0.0",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1",
    "cli-highlight": "^2.1.11",
    "diff": "^7.0.0",
    "fast-glob": "^3.3.3",
    "zod": "^3.24.0",
    "chalk": "^5.4.0",
    "strip-ansi": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/diff": "^7.0.0",
    "typescript": "^5.7.0"
  }
}
